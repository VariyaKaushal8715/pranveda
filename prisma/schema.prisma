generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  phone        String?
  passwordHash String
  role         String         @default("CUSTOMER") // CUSTOMER | ADMIN
  address      String?
  city         String?
  state        String?
  pincode      String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  orders   Order[]
  reviews  Review[]
  wishlist WishlistItem[]
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())

  products Product[]
}

model Product {
  id             String         @id @default(cuid())
  name           String
  slug           String         @unique
  subtitle       String?
  description    String
  ingredients    String?
  benefits       String?
  howToUse       String?
  price          Int            // INR whole rupees
  compareAtPrice Int?
  packSize       String         @default("100g")
  stock          Int            @default(50)
  categoryId     String
  category       Category       @relation(fields: [categoryId], references: [id])
  concerns       String         @default("[]") // JSON array of health concerns
  images         String         @default("[]") // JSON array of image URLs
  isFeatured     Boolean        @default(false)
  isBestSeller   Boolean        @default(false)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  reviews    Review[]
  wishlist   WishlistItem[]
  orderItems OrderItem[]
}

model Review {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName       String
  rating           Int
  title            String?
  comment          String
  verifiedPurchase Boolean  @default(false)
  createdAt        DateTime @default(now())
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Coupon {
  id             String   @id @default(cuid())
  code           String   @unique
  discountType   String   @default("PERCENT") // PERCENT | FLAT
  discountValue  Int
  minOrderAmount Int      @default(0)
  maxDiscount    Int?
  isActive       Boolean  @default(true)
  usageCount     Int      @default(0)
  createdAt      DateTime @default(now())
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique
  userId            String?
  user              User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName      String
  customerEmail     String
  customerPhone     String
  shippingAddress   String
  shippingCity      String
  shippingState     String
  shippingPincode   String
  notes             String?
  subtotal          Int
  discount          Int         @default(0)
  couponCode        String?
  shippingFee       Int         @default(0)
  total             Int
  paymentMethod     String      @default("COD") // COD | RAZORPAY
  paymentStatus     String      @default("PENDING") // PENDING | PAID | FAILED
  razorpayOrderId   String?
  razorpayPaymentId String?
  orderStatus       String      @default("PLACED") // PLACED | PACKED | SHIPPED | DELIVERED | CANCELLED
  trackingNote      String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  items OrderItem[]
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName  String
  productImage String?
  packSize     String?
  price        Int
  quantity     Int
}

model StoreSetting {
  id                    String   @id @default("default")
  storeName             String   @default("PranVeda")
  tagline               String   @default("Ancient Wisdom, Pure Vitality")
  whatsappNumber        String   @default("919876543210")
  supportEmail          String   @default("care@pranveda.in")
  address               String   @default("104 Botanical Arcade, SG Highway, Ahmedabad, Gujarat 380054")
  instagramUrl          String   @default("https://instagram.com/pranveda.ayurveda")
  freeShippingThreshold Int      @default(499)
  shippingFee           Int      @default(49)
  updatedAt             DateTime @updatedAt
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  type      String   // WELCOME | ORDER_CONFIRMATION | ORDER_STATUS | ADMIN_NEW_ORDER
  html      String
  status    String   // SENT | DEMO_LOGGED | FAILED
  error     String?
  createdAt DateTime @default(now())
}
